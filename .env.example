# Copy this file to `.env.local` and fill in your values.
# Find them in the Supabase dashboard: Project Settings > API Keys (and Data API for the URL).
#
# Only use the PUBLISHABLE key (starts with `sb_publishable_`) or the legacy `anon` key.
# NEVER put the secret / service_role key here: EXPO_PUBLIC_ values are bundled into the app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
